# =============================================================================
# TRAMXANH CONFIGURATION (.env)
# =============================================================================

# Database Mode: "auto" (try SQL Server first, fallback to SQLite), "mssql", or "sqlite"
DB_MODE=auto

# Microsoft SQL Server Connection String (used when DB_MODE=mssql or auto)
MSSQL_SERVER=localhost
MSSQL_DATABASE=TramXanhDB
MSSQL_DRIVER=SQL Server
# Example SQLAlchemy URL for SQL Server (Windows Authentication):
# DATABASE_URL=mssql+pyodbc://@localhost/TramXanhDB?driver=SQL+Server&trusted_connection=yes

# SQLite Fallback Database File
SQLITE_PATH=tramxanh.db

# Local AI Model Settings
MODEL_PATH=models/resnet18_phase2_best.pth
IMAGE_SIZE=224
CONFIDENCE_THRESHOLD=0.50

# Web Application Secret Key
SECRET_KEY=tramxanh-secret-key-2026-dong-bang-song-hong

